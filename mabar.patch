+/** Data akun yang dibutuhkan Mabar (dipisah dari MinecraftAccount supaya MabarLan tidak bergantung ke kelas Java). */
+class MabarAccount(
+    val username: String,
+    val profileId: String,
+    val skinFile: File,
+    val capeFile: File,
