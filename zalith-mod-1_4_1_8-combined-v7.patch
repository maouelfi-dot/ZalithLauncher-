diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..8e0f71d
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,78 @@
+name: Build and Release APK
+
+# Otomatis build semua APK lalu upload ke GitHub Releases.
+# Cara pakai: push tag, misalnya  git tag v1.4.1.8 && git push origin v1.4.1.7
+# Atau jalankan manual dari tab Actions (isi nama tag).
+on:
+  push:
+    tags:
+      - 'v*'
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: 'Nama tag rilis (contoh: v1.4.1.8)'
+        required: true
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    runs-on: ubuntu-22.04
+    strategy:
+      matrix:
+        arch: [ "all", "arm", "arm64", "x86", "x86_64" ]
+      fail-fast: false
+
+    env:
+      CURSEFORGE_API_KEY: ${{ secrets.CURSEFORGE_API_KEY }}
+      ZL_BUILD_TYPE: RELEASE
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Build JRE JAR files
+        run: |
+          chmod +x gradlew
+          mkdir out
+          ./gradlew jre_lwjgl3glfw:build --no-daemon
+
+      - name: Build APK ${{ matrix.arch }}
+        env:
+          MOVTERY_KEYSTORE_PASSWORD: ${{ secrets.MOVTERY_KEYSTORE_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          ./gradlew ZalithLauncher:assemblerelease -Darch=${{ matrix.arch }}
+
+      - name: Upload artifact ${{ matrix.arch }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: apk-${{ matrix.arch }}
+          path: ZalithLauncher/build/outputs/apk/release/*.apk
+          if-no-files-found: error
+
+  release:
+    needs: build
+    runs-on: ubuntu-22.04
+    steps:
+      - name: Download all APKs
+        uses: actions/download-artifact@v4
+        with:
+          pattern: apk-*
+          path: apks
+          merge-multiple: true
+
+      - name: Create GitHub Release
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ${{ github.event.inputs.tag || github.ref_name }}
+          name: ${{ github.event.inputs.tag || github.ref_name }}
+          generate_release_notes: true
+          files: apks/*.apk
diff --git a/ZalithLauncher/build.gradle.kts b/ZalithLauncher/build.gradle.kts
index 006196f..95cdbb7 100644
--- a/ZalithLauncher/build.gradle.kts
+++ b/ZalithLauncher/build.gradle.kts
@@ -103,7 +103,10 @@ android {
             isMinifyEnabled = false
             proguardFiles(getDefaultProguardFile("proguard-android.txt"), "proguard-rules.pro")
             resValue("string", "storageProviderAuthorities", storageProviderId)
-            signingConfig = signingConfigs.getByName("releaseBuild")
+            // Fork tanpa kunci rilis resmi: tanda tangani dengan debug.keystore agar build otomatis tetap jalan
+            signingConfig = if (System.getenv("MOVTERY_KEYSTORE_PASSWORD").isNullOrEmpty())
+                signingConfigs.getByName("customDebug")
+            else signingConfigs.getByName("releaseBuild")
         }
     }
 
